@page "/telechargement"
@page "/downloader"
@inject DownloadService Download
@inject AppGuardService Guard
@inject QobuzApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AmbianceService Ambiance
@inherits LocalizedComponentBase

@* Instantanés pris une fois par rendu : le worker mute les collections sur un autre thread, les
   énumérer lèverait « Collection was modified ». Filtrés sur l'utilisateur connecté. *@
@{
    var queue = Download.QueueSnapshot(_me);
    var log = Download.LogSnapshot(_me);
    var progress = Download.ProgressFor(_me);
    var running = queue.FirstOrDefault(i => i.Status == QueueItemStatus.Running);
    var firstPending = queue.FirstOrDefault(i => i.Status == QueueItemStatus.Pending);
    var lastPending = queue.LastOrDefault(i => i.Status == QueueItemStatus.Pending);
    var pendingCount = queue.Count(i => i.Status == QueueItemStatus.Pending);
    var finishedCount = queue.Count(i => i.IsFinished);
}

<h3 style="margin-bottom:16px;">@Loc["download.title"]</h3>

<p class="dl-quality">
    @Loc["download.qualityLabel"] <strong>@QualityLabel</strong> — <a class="lnk" href="/settings">@Loc["download.qualityEdit"]</a>
</p>

<div class="url-field">
    <input type="text" inputmode="url" enterkeyhint="go" autocomplete="off" spellcheck="false"
           aria-label='@Loc["download.urlPlaceholder"]' placeholder='@Loc["download.urlPlaceholder"]'
           @bind="_inputUrl" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <button type="button" class="lnk url-field-batch" aria-expanded="@(_showBatch ? "true" : "false")"
            @onclick="() => _showBatch = !_showBatch">@Loc["download.batch"]</button>
    <button type="button" class="btn btn-primary" @onclick="StartDownload" disabled="@string.IsNullOrWhiteSpace(_inputUrl)">@Loc["download.start"]</button>
</div>

@if (_showBatch)
{
    <div class="batch-panel">
        <textarea @bind="_batchUrls" rows="5" aria-label='@Loc["download.batchPlaceholder"]' placeholder='@Loc["download.batchPlaceholder"]'></textarea>
        <button type="button" class="btn btn-primary" @onclick="StartBatch">@Loc["download.batchStart"]</button>
    </div>
}

@* Carte « En cours » : l'étiquette du disque est la pochette recadrée en rond. Le disque ne tourne
   que pendant le téléchargement, et jamais si l'appareil demande moins d'animations. *@
@if (running != null)
{
    var album = progress.CurrentAlbum;
    var cover = FirstNonEmpty(album?.Image?.Large, album?.Image?.Small, running.Thumbnail);
    var label = FirstNonEmpty(album?.Image?.Small, running.Thumbnail);
    var title = album != null ? album.Title + (album.Version != null ? $" ({album.Version})" : "") : running.Label;
    var artist = album?.Artist?.Name ?? running.SubLabel;
    var percent = Math.Clamp(progress.Percent, 0, 100);
    var segments = progress.Steps is > 0 and <= MaxSegments ? progress.Steps : 0;

    <section class="now-panel" aria-labelledby="now-title">
        <div class="sortie" aria-hidden="true">
            <div class="sortie-disque @(progress.IsRunning ? "tourne" : "")">
                <div class="sortie-etiquette">
                    @if (label != null)
                    {
                        <img src="@label" alt="" />
                    }
                </div>
                <div class="sortie-trou"></div>
            </div>
            <div class="sortie-pochette">
                @if (cover != null)
                {
                    <img src="@cover" alt="" />
                }
            </div>
        </div>

        <div class="now-info">
            <span class="now-cap">@Loc["shell.now"]</span>
            <h4 id="now-title" class="now-title">@title</h4>
            @if (!string.IsNullOrEmpty(artist))
            {
                <p class="now-artist">@artist</p>
            }
            @if (album != null)
            {
                <p class="now-meta">
                    @album.ReleaseDateOriginal / @Loc.P("search.trackCount", album.TracksCount) / <strong>@(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz</strong>
                </p>
            }

            <div class="now-pct" aria-hidden="true">@percent<small>%</small></div>

            @* Un segment par piste quand le service les compte (album, playlist) ; sinon une barre. *@
            <div class="now-progress" role="progressbar" aria-label='@Loc["download.progress"]'
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent">
                @if (segments > 0)
                {
                    <div class="seg" style="grid-template-columns:repeat(@segments, minmax(0, 1fr))">
                        @for (var i = 0; i < segments; i++)
                        {
                            <i class="@(i < progress.Step ? "d" : i == progress.Step ? "c" : "")"></i>
                        }
                    </div>
                }
                else
                {
                    <div class="now-bar"><i style="width:@(percent)%"></i></div>
                }
            </div>

            <div class="now-status">
                @if (segments > 0)
                {
                    <strong>@Loc.T("download.trackOf", Math.Min(progress.Step + 1, segments), segments)</strong>
                }
                @if (!string.IsNullOrEmpty(progress.CurrentItem))
                {
                    <span class="now-item">@progress.CurrentItem</span>
                }
                <span class="now-speed">@progress.Status</span>
            </div>

            <div class="now-actions">
                <button type="button" class="btn btn-outline" @onclick="() => Download.CancelCurrent(_me)" title='@Loc["queue.cancelCurrentHint"]'>
                    <NavIcon Name="close" /><span>@Loc["download.cancel"]</span>
                </button>
                <button type="button" class="btn btn-secondary" @onclick="() => Download.SkipCurrent(_me)" title='@Loc["queue.skipHint"]'>@Loc["download.skip"]</button>
            </div>
        </div>
    </section>
}

<div class="dl-columns">
    <section class="dl-queue" aria-labelledby="queue-title">
        <div class="section-head">
            <h4 id="queue-title" class="section-title">@Loc["queue.title"]</h4>
            @if (queue.Count > 0)
            {
                <span class="section-count">@Loc.P("queue.count", queue.Count)</span>
            }
            <span class="section-tools">
                @if (finishedCount > 0)
                {
                    <button type="button" class="lnk" @onclick="() => Download.ClearFinished(_me)">@Loc["queue.clearFinished"]</button>
                }
                @if (pendingCount > 0)
                {
                    <button type="button" class="lnk" @onclick="() => Download.ClearPending(_me)">@Loc["queue.clearPending"]</button>
                }
            </span>
        </div>

        @if (queue.Count == 0)
        {
            <p class="queue-empty">@Loc["queue.empty"]</p>
        }
        else
        {
            <div class="queue-list">
                @* @key est indispensable : sans lui, réordonner fait réutiliser les nœuds en place par
                   Blazor et les états disabled des flèches se désynchronisent de la ligne affichée. *@
                @foreach (var it in queue)
                {
                    <div class="qrow @RowClass(it)" @key="it.Id">
                        @if (!string.IsNullOrEmpty(it.Thumbnail))
                        {
                            <img class="qrow-thumb" src="@it.Thumbnail" alt="" width="52" height="52" loading="lazy" decoding="async" />
                        }
                        else
                        {
                            <span class="qrow-thumb qrow-thumb-empty" aria-hidden="true">@(Loc[$"queue.kind.{it.Kind}"])</span>
                        }

                        <div class="qrow-text">
                            <div class="rt" title="@it.Label">@it.Label</div>
                            <div class="rm">
                                @Loc[$"queue.kind.{it.Kind}"]
                                @if (!string.IsNullOrEmpty(it.SubLabel))
                                {
                                    <text>&middot; @it.SubLabel</text>
                                }
                            </div>
                            @* La forme du badge porte l'état : plein (en cours), pointillé (en attente),
                               verre (terminé), contour (échec), barré (annulé). *@
                            <span class="bdg @BadgeClass(it.Status)"><i></i>@(Loc[$"queue.status.{StatusKey(it.Status)}"])</span>
                            @if (it.Status == QueueItemStatus.Failed && !string.IsNullOrEmpty(it.Error))
                            {
                                <div class="qrow-err">@it.Error</div>
                            }
                        </div>

                        @* Trois boutons au plus par ligne, pour tenir à 375px : Annuler et Passer
                           vivent dans la carte « En cours », affichée tant qu'un élément tourne. *@
                        <div class="qrow-actions">
                            @if (it.Status == QueueItemStatus.Pending)
                            {
                                <button type="button" class="ic" @onclick="() => Download.MoveUp(_me, it.Id)" disabled="@(it == firstPending)"
                                        aria-label='@Loc.T("search.itemAction", Loc["queue.action.up"], it.Label)' title='@Loc["queue.action.up"]'><NavIcon Name="up" /></button>
                                <button type="button" class="ic" @onclick="() => Download.MoveDown(_me, it.Id)" disabled="@(it == lastPending)"
                                        aria-label='@Loc.T("search.itemAction", Loc["queue.action.down"], it.Label)' title='@Loc["queue.action.down"]'><NavIcon Name="down" /></button>
                                <button type="button" class="ic" @onclick="() => Download.Remove(_me, it.Id)"
                                        aria-label='@Loc.T("search.itemAction", Loc["queue.action.remove"], it.Label)' title='@Loc["queue.action.remove"]'><NavIcon Name="close" /></button>
                            }
                            else if (it.Status != QueueItemStatus.Running)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Download.Retry(_me, it.Id)"
                                        aria-label='@Loc.T("search.itemAction", Loc["queue.action.retry"], it.Label)'>@Loc["queue.action.retry"]</button>
                                <button type="button" class="ic" @onclick="() => Download.Remove(_me, it.Id)"
                                        aria-label='@Loc.T("search.itemAction", Loc["queue.action.remove"], it.Label)' title='@Loc["queue.action.remove"]'><NavIcon Name="close" /></button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="dl-log" aria-labelledby="log-title">
        <div class="section-head">
            <h4 id="log-title" class="section-title">@Loc["download.log"]</h4>
            @if (log.Count > 0)
            {
                <span class="section-tools">
                    <button type="button" class="lnk" @onclick="() => Download.ClearLog(_me)">@Loc["queue.clearLog"]</button>
                </span>
            }
        </div>
        <div class="log-output" @ref="_logRef" role="log" aria-live="off">
            @foreach (var line in log)
            {
                <div>@line</div>
            }
            @if (log.Count == 0)
            {
                <div class="log-empty">@Loc["download.logEmpty"]</div>
            }
        </div>
    </section>
</div>

@code {
    private string _inputUrl = "";
    private string _batchUrls = "";
    private bool _showBatch;
    private ElementReference _logRef;
    private int _lastLogCount = -1;

    // Capturé une fois : les événements de la file arrivent depuis les workers, hors du circuit, et
    // n'ont qu'à comparer un identifiant.
    private string _me = "";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _me = Guard.UserId;
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        Download.OnProgressChanged += OnProgress;
        Download.OnQueueChanged += OnProgress;
        UpdateAmbiance();
    }

    // Les autres utilisateurs téléchargent en même temps : ne se redessiner que pour sa propre file.
    // null = changement qui concerne tout le monde. Le mur est recalculé dans le contexte du
    // circuit ; SetCovers ne prévient la coquille que si la liste a changé.
    private void OnProgress(string? ownerId)
    {
        if (ownerId != null && ownerId != _me) return;
        InvokeAsync(() =>
        {
            UpdateAmbiance();
            StateHasChanged();
        });
    }

    // Mur du fond : l'album en cours puis les pochettes de la file.
    private void UpdateAmbiance()
    {
        var current = Download.ProgressFor(_me).CurrentAlbum?.Image?.Thumbnail;
        var covers = Download.QueueSnapshot(_me).Select(i => i.Thumbnail).Prepend(current);
        Ambiance.SetCovers(this, covers);
    }

    // Au-delà, les segments deviennent des traits illisibles : la page revient à la barre.
    private const int MaxSegments = 40;

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrEmpty(v));

    private static string BadgeClass(QueueItemStatus s) => s switch
    {
        QueueItemStatus.Running => "run",
        QueueItemStatus.Pending => "pen",
        QueueItemStatus.Completed => "ok",
        QueueItemStatus.Failed => "ko",
        _ => "ann"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var count = Download.LogCount(_me);
        if (count == _lastLogCount) return;
        _lastLogCount = count;
        try { await JS.InvokeVoidAsync("scrollToBottom", _logRef); }
        catch (JSDisconnectedException) { /* circuit fermé pendant le rendu */ }
        catch (TaskCanceledException) { /* idem, côté interop */ }
    }

    // Fire-and-forget : Enqueue rend la main tout de suite, le worker de fond draine. C'est ce qui
    // permet de continuer à naviguer pendant un téléchargement.
    private void StartDownload()
    {
        if (string.IsNullOrWhiteSpace(_inputUrl)) return;
        // On ne vide le champ qu'en cas de succès : sur une URL invalide, l'utilisateur doit
        // pouvoir la corriger plutôt que la retaper.
        if (Download.Enqueue(_me, _inputUrl.Trim()) != EnqueueResult.InvalidUrl)
            _inputUrl = "";
    }

    private void StartBatch()
    {
        var urls = _batchUrls.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
        if (urls.Count == 0) return;
        Download.EnqueueMany(_me, urls.Select(u => new QueueRequest(u)));
        _batchUrls = "";
    }

    // Simple rappel : la qualité se choisit dans les Paramètres.
    private string QualityLabel => Guard.Settings.QualityFormat switch
    {
        "5" => "MP3 320",
        "6" => "FLAC 16bit",
        "7" => "FLAC 24bit ≤96kHz",
        "27" => "FLAC 24bit 192kHz",
        _ => Loc["download.quality.unknown"]
    };

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") StartDownload();
    }

    private static string StatusKey(QueueItemStatus s) => s switch
    {
        QueueItemStatus.Pending => "pending",
        QueueItemStatus.Running => "running",
        QueueItemStatus.Completed => "done",
        QueueItemStatus.Failed => "failed",
        _ => "cancelled"
    };

    private static string RowClass(QueueItem it) => it.Status switch
    {
        QueueItemStatus.Running => "running",
        QueueItemStatus.Completed => "done",
        QueueItemStatus.Failed => "failed",
        QueueItemStatus.Cancelled => "cancelled",
        _ => ""
    };

    public override void Dispose()
    {
        base.Dispose();
        Download.OnProgressChanged -= OnProgress;
        Download.OnQueueChanged -= OnProgress;
        Ambiance.Clear(this);
    }
}
