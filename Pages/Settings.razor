@page "/settings"
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities
@inject SettingsService SettingsSvc
@inject UserStore Users
@inject AppGuardService Guard
@inject QobuzApiService Api
@inject DownloadService Download
@inject IJSRuntime JS
@inject NavigationManager Nav
@inherits LocalizedComponentBase

<h3 style="margin-bottom:16px;">@Loc["settings.title"]</h3>

@* Sections en colonnes (trois au bureau, une sur mobile) : chacune reste d'un seul tenant. *@
<div class="settings-cols">

<!-- Compte Qobuz — en premier : sans abonnement actif, rien d'autre sur cette page n'a d'effet.
     Partagé par tous les utilisateurs : chacun le consulte, seul un administrateur le déconnecte. -->
<div class="card">
    <div class="card-title">@Loc["settings.account.title"]</div>

    @if (!A.HasSubscription || A.IsSubscriptionExpired())
    {
        <div class="account-alert">
            @(!A.HasSubscription ? Loc["settings.account.noneWarning"] : Loc["settings.account.expiredWarning"])
        </div>
    }

    <div class="settings-grid">
        <div class="form-group">
            <label>@Loc["settings.account.user"]</label>
            <div class="account-value">@Dash(A.UserDisplayName)</div>
        </div>
        <div class="form-group">
            <label>@Loc["settings.account.offer"]</label>
            <div class="account-value">@(string.IsNullOrEmpty(A.SubscriptionOffer) ? Loc["settings.account.noOffer"] : A.SubscriptionOffer)</div>
        </div>
        <div class="form-group">
            <label>@Loc["settings.account.expires"]</label>
            <div class="account-value">@FormatDate(A.SubscriptionEndDate)</div>
        </div>
        <div class="form-group">
            <label>@Loc["settings.account.country"]</label>
            <div class="account-value">@Dash(A.UserCountry)</div>
        </div>
        <div class="form-group">
            <label>@Loc["settings.account.rights"]</label>
            <div class="account-value">@StreamingRights</div>
        </div>
    </div>

    @* Après un renouvellement, relire la fiche ici évite d'avoir à se déconnecter puis reconnecter —
       et c'est aussi ce qui débloque la file restée en attente. *@
    <div style="margin-top:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <button class="btn btn-secondary" @onclick="RefreshAccount" disabled="@_refreshing">
            @(_refreshing ? Loc["settings.account.refreshing"] : Loc["settings.account.refresh"])
        </button>
        @* Couperait le téléchargement de tous les utilisateurs : réservé à l'administrateur, et
           confirmé par un second clic. *@
        @if (Guard.IsAdmin && _confirmDisconnect)
        {
            <button class="btn btn-danger" @onclick="DisconnectQobuz">@Loc["settings.account.disconnectConfirm"]</button>
            <button class="btn btn-secondary" @onclick="() => _confirmDisconnect = false">@Loc["common.cancel"]</button>
        }
        else if (Guard.IsAdmin)
        {
            <button class="btn btn-outline" @onclick="() => _confirmDisconnect = true">@Loc["settings.account.disconnect"]</button>
        }
        @if (!string.IsNullOrEmpty(_accountMessage))
        {
            <span style="font-size:0.85em;color:var(--text-secondary);">@_accountMessage</span>
        }
    </div>
</div>

<!-- Download Folder — fixé par l'administrateur : un utilisateur qui le choisirait pourrait écrire
     n'importe où dans le conteneur. -->
<div class="card">
    <div class="card-title">@Loc["settings.folder.title"]</div>
    <div class="form-group">
        <label>@Loc["settings.folder.location"]</label>
        <div class="account-value">@S.DownloadLocation</div>
    </div>
    <div style="font-size:0.8em;color:var(--text-secondary);margin-top:4px;">
        @if (Guard.IsAdmin)
        {
            <span>@Loc["settings.folder.adminHint"] <a href="/users">@Loc["nav.users"]</a></span>
        }
        else
        {
            <span>@Loc["settings.folder.userHint"]</span>
        }
    </div>
</div>

<div class="card">
    <div class="card-title">@Loc["settings.quality.title"]</div>
    <div class="quality-group">
        <button class="quality-btn @(S.QualityFormat == "5" ? "active" : "")" @onclick='() => SetQuality("5", ".mp3")'>MP3 320</button>
        <button class="quality-btn @(S.QualityFormat == "6" ? "active" : "")" @onclick='() => SetQuality("6", ".flac")'>FLAC 16bit</button>
        <button class="quality-btn @(S.QualityFormat == "7" ? "active" : "")" @onclick='() => SetQuality("7", ".flac")'>FLAC 24bit &le;96kHz</button>
        <button class="quality-btn @(S.QualityFormat == "27" ? "active" : "")" @onclick='() => SetQuality("27", ".flac")'>FLAC 24bit 192kHz</button>
    </div>
    <div style="font-size:0.8em;color:var(--text-secondary);margin-top:8px;">
        @Loc["settings.quality.hint"]
    </div>
</div>

