        <label class="setting-item"><input type="checkbox" @bind="S.AlbumArtistTag" @bind:after="Save" /><span>@Loc["settings.tag.albumArtist"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.ArtistTag" @bind:after="Save" /><span>@Loc["settings.tag.artist"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.TrackTitleTag" @bind:after="Save" /><span>@Loc["settings.tag.trackTitle"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.TrackTag" @bind:after="Save" /><span>@Loc["settings.tag.trackNumber"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.TotalTracksTag" @bind:after="Save" /><span>@Loc["settings.tag.totalTracks"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.DiscTag" @bind:after="Save" /><span>@Loc["settings.tag.disc"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.TotalDiscsTag" @bind:after="Save" /><span>@Loc["settings.tag.totalDiscs"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.GenreTag" @bind:after="Save" /><span>@Loc["settings.tag.genre"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.YearTag" @bind:after="Save" /><span>@Loc["settings.tag.year"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.ReleaseDateTag" @bind:after="Save" /><span>@Loc["settings.tag.releaseDate"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.ComposerTag" @bind:after="Save" /><span>@Loc["settings.tag.composer"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.CopyrightTag" @bind:after="Save" /><span>@Loc["settings.tag.copyright"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.LabelTag" @bind:after="Save" /><span>@Loc["settings.tag.label"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.IsrcTag" @bind:after="Save" /><span>@Loc["settings.tag.isrc"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.UpcTag" @bind:after="Save" /><span>@Loc["settings.tag.upc"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.TypeTag" @bind:after="Save" /><span>@Loc["settings.tag.type"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.ExplicitTag" @bind:after="Save" /><span>@Loc["settings.tag.explicit"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.ImageTag" @bind:after="Save" /><span>@Loc["settings.tag.artwork"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.UrlTag" @bind:after="Save" /><span>@Loc["settings.tag.url"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.MergeArtistNames" @bind:after="Save" /><span>@Loc["settings.tag.mergeArtists"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.MergeArtistNamesInDirNames" @bind:after="Save" /><span>@Loc["settings.tag.mergeArtistsDirs"]</span></label>
