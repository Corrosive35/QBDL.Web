    <div style="margin-top:12px;">
        <label class="setting-item"><input type="checkbox" @bind="S.ExplicitTagInTitle" @bind:after="Save" /><span>@Loc["settings.tag.explicitInTitle"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.CleanTagInTitle" @bind:after="Save" /><span>@Loc["settings.tag.cleanInTitle"]</span></label>
    </div>
</div>

