                <option value="50">50</option>
                <option value="100">100</option>
                <option value="150">150</option>
                <option value="230">230</option>
                <option value="300">300</option>
                <option value="600">600</option>
            </select>
        </div>
    </div>
    <label class="setting-item"><input type="checkbox" @bind="S.DontSaveArtworkToDisk" @bind:after="Save" /><span>@Loc["settings.artwork.dontSave"]</span></label>
</div>

<div class="card">
    <div class="card-title">@Loc["settings.advanced.title"]</div>
    <div class="settings-grid">
        <label class="setting-item"><input type="checkbox" @bind="S.StreamableCheck" @bind:after="Save" /><span>@Loc["settings.advanced.streamable"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.FixMD5s" @bind:after="Save" /><span>@Loc["settings.advanced.fixMd5"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.DownloadGoodies" @bind:after="Save" /><span>@Loc["settings.advanced.goodies"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.DownloadSpeed" @bind:after="Save" /><span>@Loc["settings.advanced.speed"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.UseItemPosInPlaylist" @bind:after="Save" /><span>@Loc["settings.advanced.playlistPos"]</span></label>
        <label class="setting-item"><input type="checkbox" @bind="S.LogFailedDownloads" @bind:after="Save" /><span>@Loc["settings.advanced.logFailed"]</span></label>
    </div>

    <div class="form-group" style="margin-top:12px;">
        <label>@Loc["settings.duplicates.label"]</label>
        <select @bind="S.DuplicateFileMode" @bind:after="Save">
            <option value="skip">@Loc["settings.duplicates.skip"]</option>
            <option value="rename">@Loc["settings.duplicates.rename"]</option>
            <option value="overwrite">@Loc["settings.duplicates.overwrite"]</option>
        </select>
    </div>
</div>

<div class="card">
    <div class="card-title">@Loc["settings.me.title"]</div>
    <div class="form-group">
        <label>@Loc["auth.username"]</label>
        <div class="account-value">@Guard.Account?.Username</div>
    </div>

    @if (_pwdMessageKey != null)
    {
        <div class="@(_pwdOk ? "form-success" : "auth-error")">@Loc[_pwdMessageKey]</div>
    }

    @* Formulaire HTML classique, posté à /auth/password : le changement de mot de passe change
       l'empreinte du cookie, que seule une vraie réponse HTTP peut réémettre. Le champ identifiant
       caché permet au gestionnaire de mots de passe d'associer le nouveau mot de passe au compte. *@
    <form method="post" action="/auth/password">
        <input type="text" name="username" autocomplete="username" value="@Guard.Account?.Username" hidden />
        <div class="settings-grid">
            <div class="form-group">
                <label for="pwd-current">@Loc["settings.me.current"]</label>
                <input id="pwd-current" name="current" type="password" autocomplete="current-password" />
            </div>
            <div class="form-group">
                <label for="pwd-new">@Loc["settings.me.new"]</label>
                <input id="pwd-new" name="password" type="password" autocomplete="new-password" />
            </div>
            <div class="form-group">
                <label for="pwd-confirm">@Loc["auth.confirm"]</label>
                <input id="pwd-confirm" name="confirm" type="password" autocomplete="new-password" />
            </div>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:8px;">@Loc["settings.me.change"]</button>
    </form>
</div>

</div>

@* Mobile : la barre latérale cède la place aux onglets, et le bloc Session (langue, déconnexion,
   version) se retrouve ici. Masqué au bureau, où la barre latérale le porte déjà. *@
<SessionPanel Class="session-page" />

@if (_showCopied)
{
    <div class="toast-notification">@Loc.T("settings.copied", _copiedToken)</div>
}

@code {
    // S : réglages de téléchargement de l'utilisateur connecté. A : le compte Qobuz de l'instance,
    // partagé par tous.
    private UserSettings S => Guard.Settings;
    private Models.AppSettings A => SettingsSvc.Settings;
    private bool _showCopied;
    private string _copiedToken = "";
    private bool _refreshing;
    private string _accountMessage = "";
    private bool _confirmDisconnect;

    // Résultat du changement de mot de passe, revenu par l'URL après le POST. Liste fermée : la
    // valeur vient de la query.
    private string? _pwdMessageKey;
    private bool _pwdOk;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("pwd", out var pwd))
        {
            _pwdMessageKey = pwd.ToString() switch
            {
                "ok" => "settings.me.pwd.ok",
                "bad" => "settings.me.pwd.bad",
                "mismatch" => "setup.error.mismatch",
                "empty" => "users.error.emptyPassword",
                "throttled" => "settings.me.pwd.throttled",
                _ => null,
            };
            _pwdOk = pwd == "ok";
        }
    }

    // Les réglages sont liés par @bind directement sur l'objet du compte : il ne reste qu'à écrire
    // users.json.
    private void Save() => Users.Save();

    // ─── Compte ───

    private static string Dash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    /// <summary>Date affichée dans la langue de l'interface. Contrairement aux noms de fichiers,
    /// qui doivent rester en culture invariante, c'est bien ici le format local qui est attendu.</summary>
    private static string FormatDate(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "—";

        return DateTime.TryParse(raw, CultureInfo.InvariantCulture, DateTimeStyles.None, out var d)
            ? d.ToString("d", CultureInfo.CurrentCulture)
            : raw;   // format inattendu : montrer la valeur brute plutôt que rien
    }

    private string StreamingRights
    {
        get
        {
            if (!A.HasSubscription) return Loc["settings.account.rights.none"];
            if (A.CanStreamHires) return Loc["settings.account.rights.hires"];
            if (A.CanStreamLossless) return Loc["settings.account.rights.lossless"];
            return Loc["settings.account.rights.lossy"];
        }
    }

    private async Task RefreshAccount()
    {
        _refreshing = true;
        _accountMessage = "";

        try
        {
            // Borné : sans cela le bouton resterait grisé jusqu'au délai par défaut de HttpClient,
            // soit 100 s, sans que rien n'indique quoi que ce soit.
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var user = await Api.GetUserInfoAsync(A.AppId, A.UserAuthToken, timeout.Token);
            if (user != null)
            {
                SettingsSvc.Update(s => s.ApplyAccountStatus(user));
                _accountMessage = Loc["settings.account.refreshed"];

                // Droits revenus : relancer les files en attente de tous les utilisateurs (compte
                // partagé), plutôt que d'obliger chacun à cliquer « relancer » élément par élément.
                if (A.HasSubscription) Download.ResumeAfterSubscriptionBlock();
            }
        }
        catch (Exception ex)
        {
            _accountMessage = Loc.T("settings.account.refreshFailed", ex.Message);
        }
        finally
        {
            _refreshing = false;
        }
    }

    // Format Qobuz (5 = MP3 320, 6 = FLAC 16bit, 7 = FLAC 24bit <=96kHz, 27 = FLAC 24bit 192kHz)
    // et extension du fichier produit, enregistrés ensemble pour rester cohérents.
    private void SetQuality(string formatId, string audioFormat)
    {
        Users.Update(Guard.UserId, u => { u.Settings.QualityFormat = formatId; u.Settings.AudioFormat = audioFormat; });
    }

    /// <summary>Déconnecte le compte Qobuz de l'instance, donc tout le monde : la barre latérale, elle,
    /// ne déconnecte que de l'application.</summary>
    private void DisconnectQobuz()
    {
        // Revérifié ici : le bouton masqué ne suffit pas à interdire l'appel.
        if (!Guard.IsAdmin) return;

        SettingsSvc.Update(s => {
            s.ClearAccount();
            s.Email = "";
            s.AppId = "";
            s.AppSecret = "";
        });
        Api.SetCredentials("", "", "");
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task CopyToken(string token)
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", token);
        }
        catch { }

        _copiedToken = token;
        _showCopied = true;
        StateHasChanged();

        await Task.Delay(1500);
        _showCopied = false;
        StateHasChanged();
    }
}
