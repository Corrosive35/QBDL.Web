@page "/"
@page "/search"
@inject QobuzApiService Api
@inject DownloadService Download
@inject SettingsService Settings
@inject SearchStateStore States
@inject AppGuardService Guard
@inject NavigationManager Nav
@inject AmbianceService Ambiance
@inherits LocalizedComponentBase

<h3 style="margin-bottom:16px;">@Loc["search.title"]</h3>

@* Les onglets lancent la recherche du type choisi ; Entrée relance la dernière. *@
<div class="search-field">
    <NavIcon Name="search" />
    <input type="text" inputmode="search" enterkeyhint="search" autocomplete="off"
           aria-label='@Loc["search.placeholder"]' placeholder='@Loc["search.placeholder"]'
           @bind="State.Query" @bind:event="oninput" @onkeydown="OnKeyDown" />
</div>

<div class="search-tabs" role="tablist" aria-label='@Loc["search.title"]'>
    @foreach (var (type, key) in SearchTypes)
    {
        var active = State.LastSearchType == type;
        <button type="button" role="tab" class="search-tab @(active ? "on" : "")" aria-selected="@(active ? "true" : "false")"
                disabled="@_searching" @onclick="() => DoSearch(type)">@Loc[key]</button>
    }
</div>

@if (_searching)
{
    <p class="search-status" role="status">@Loc["search.searching"]</p>
}

@if (State.Albums is { Count: > 0 } albums)
{
    <section class="results" aria-label='@Loc["search.albums"]'>
        <div class="results-head">
            <span class="results-count">@Loc.P("search.results", albums.Count)</span>
            <span class="results-tools">
                <select class="sort-select" aria-label='@Loc["search.sort"]' @bind="State.AlbumSort">
                    <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                    <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                    <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                    <option value="@SearchSort.ArtistAsc">@Loc["sort.artistAsc"]</option>
                    <option value="@SearchSort.ArtistDesc">@Loc["sort.artistDesc"]</option>
                    <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
                    <option value="@SearchSort.DateAsc">@Loc["sort.dateAsc"]</option>
                    <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                    <option value="@SearchSort.CountDesc">@Loc["sort.tracksDesc"]</option>
                    <option value="@SearchSort.CountAsc">@Loc["sort.tracksAsc"]</option>
                    <option value="@SearchSort.LabelAsc">@Loc["sort.labelAsc"]</option>
                </select>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleSelectAllAlbums">@(_selectedAlbums.Count == albums.Count ? Loc["search.deselectAll"] : Loc["search.selectAll"])</button>
            </span>
        </div>
        <div class="alb-grid">
            @foreach (var album in SearchSorter.SortAlbums(albums, State.AlbumSort))
            {
                @(AlbumTile(album, withArtist: true))
            }
        </div>
    </section>
}

@if (State.Tracks is { Count: > 0 } tracks)
{
    <section class="results" aria-label='@Loc["search.tracks"]'>
        <div class="results-head">
            <span class="results-count">@Loc.P("search.results", tracks.Count)</span>
            <span class="results-tools">
                <select class="sort-select" aria-label='@Loc["search.sort"]' @bind="State.TrackSort">
                    <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                    <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                    <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                    <option value="@SearchSort.ArtistAsc">@Loc["sort.artistAsc"]</option>
                    <option value="@SearchSort.AlbumAsc">@Loc["sort.albumAsc"]</option>
                    <option value="@SearchSort.DurationAsc">@Loc["sort.durationAsc"]</option>
                    <option value="@SearchSort.DurationDesc">@Loc["sort.durationDesc"]</option>
                    <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                    <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
                </select>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="ToggleSelectAllTracks">@(_selectedTracks.Count == tracks.Count ? Loc["search.deselectAll"] : Loc["search.selectAll"])</button>
            </span>
        </div>
        <div class="row-list">
            @foreach (var track in SearchSorter.SortTracks(tracks, State.TrackSort))
            {
                var trackId = track.Id;
                var trackUrl = TrackUrl(trackId);
                var selected = _selectedTracks.Contains(trackId);
                var queued = Download.IsQueued(_me, trackUrl);
                var title = track.Title + (track.Version != null ? $" ({track.Version})" : "");
                <div class="r @(selected ? "is-sel-row" : "")" @key="trackId">
                    @(Cover(track.Album?.Image, 48))
                    <div class="r-text">
                        <div class="rt" title="@title">@title</div>
                        <div class="rm">@track.Performer?.Name &middot; @track.Album?.Title</div>
                        <div class="r-format">
                            @(track.MaximumBitDepth)bit/@(track.MaximumSamplingRate)kHz
                            @if (Download.IsDone(_me, trackUrl))
                            {
                                <span class="r-etat">&middot; @Loc["queue.doneMark"]</span>
                            }
                        </div>
                    </div>
                    <div class="alb @(selected ? "is-sel" : "") @(queued ? "is-file" : "")">
                        @(Capsule(title, selected, queued, () => ToggleTrack(trackId), () => QueueTrack(track), compact: true))
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (State.Artists is { Count: > 0 } artists)
{
    <section class="results" aria-label='@Loc["search.artists"]'>
        <div class="results-head">
            <span class="results-count">@Loc.P("search.results", artists.Count)</span>
            <span class="results-tools">
                <select class="sort-select" aria-label='@Loc["search.sort"]' @bind="State.ArtistSort">
                    <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                    <option value="@SearchSort.TitleAsc">@Loc["sort.nameAsc"]</option>
                    <option value="@SearchSort.TitleDesc">@Loc["sort.nameDesc"]</option>
                    <option value="@SearchSort.CountDesc">@Loc["sort.albumsDesc"]</option>
                    <option value="@SearchSort.CountAsc">@Loc["sort.albumsAsc"]</option>
                </select>
            </span>
        </div>
        <div class="row-list">
            @foreach (var artist in SearchSorter.SortArtists(artists, State.ArtistSort))
            {
                var artistId = artist.Id;
                var artistUrl = ArtistUrl(artistId);
                var isExpanded = State.ExpandedArtistId == artistId;
                var queued = Download.IsQueued(_me, artistUrl);
                <div class="artist-block @(isExpanded ? "expanded" : "")" @key="artistId">
                    <div class="r artist-row">
                        @* Un vrai bouton pour déplier : atteignable au clavier, état annoncé. *@
                        <button type="button" class="artist-toggle" aria-expanded="@(isExpanded ? "true" : "false")" @onclick="() => ToggleArtist(artistId)">
                            @if (!string.IsNullOrEmpty(artist.Picture))
                            {
                                <img src="@artist.Picture" alt="" class="artist-avatar" width="48" height="48" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="artist-avatar artist-avatar-placeholder" aria-hidden="true">@(artist.Name?.Length > 0 ? artist.Name[0].ToString().ToUpper() : "?")</span>
                            }
                            <span class="r-text">
                                <span class="rt">@artist.Name</span>
                                <span class="rm">
                                    @Loc.P("search.albumCount", artist.AlbumsCount)
                                    @if (Download.IsDone(_me, artistUrl))
                                    {
                                        <span class="r-etat">&middot; @Loc["queue.doneMark"]</span>
                                    }
                                </span>
                            </span>
                            <span class="expand-icon" aria-hidden="true"><NavIcon Name="chevron" /></span>
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm artist-dl" disabled="@queued" @onclick="() => QueueArtist(artist)"
                                aria-label='@Loc.T("search.itemAction", queued ? Loc["search.inQueue"] : Loc["search.downloadAll"], artist.Name)'>
                            <NavIcon Name="download" /><span class="btn-label">@(queued ? Loc["search.inQueue"] : Loc["search.downloadAll"])</span>
                        </button>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="artist-albums">
                            @if (_loadingArtistAlbums)
                            {
                                <p class="search-status" role="status">@Loc["search.loadingAlbums"]</p>
                            }
                            else if (State.ArtistAlbums is { Count: > 0 } artistAlbums)
                            {
                                <div class="results-head">
                                    <span class="results-count">@Loc.P("search.albumCount", artistAlbums.Count)</span>
                                    <span class="results-tools">
                                        <select class="sort-select" aria-label='@Loc["search.sort"]' @bind="State.ArtistAlbumSort">
                                            <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                                            <option value="@SearchSort.DateAsc">@Loc["sort.dateAsc"]</option>
                                            <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
                                            <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                                            <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                                            <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                                            <option value="@SearchSort.CountDesc">@Loc["sort.tracksDesc"]</option>
                                            <option value="@SearchSort.CountAsc">@Loc["sort.tracksAsc"]</option>
                                            <option value="@SearchSort.LabelAsc">@Loc["sort.labelAsc"]</option>
                                        </select>
                                    </span>
                                </div>
                                <div class="alb-grid">
                                    @foreach (var album in SearchSorter.SortAlbums(artistAlbums, State.ArtistAlbumSort))
                                    {
                                        @(AlbumTile(album, withArtist: false))
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="search-status">@Loc["search.noAlbums"]</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@* Barre de sélection collante : la page réserve sa hauteur en bas (app.css), elle ne masque donc
   jamais la dernière rangée. *@
@if (TotalSelected > 0)
{
    <div class="selection-bar" role="region" aria-label='@Loc["search.selectionBar"]'>
        <span>@Loc.P("search.selected", TotalSelected)</span>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="ClearSelection">@Loc["search.clearSelection"]</button>
        <button type="button" class="btn btn-primary btn-sm" @onclick="DownloadSelected">@Loc["search.downloadSelection"]</button>
    </div>
}

@* @key incrémental : l'animation CSS ne se déclenche qu'à la création du nœud. Sans lui, Blazor
   réutiliserait le même <div> pour un second toast et celui-ci apparaîtrait déjà effacé. *@
@if (_toast != null)
{
    <div class="toast-notification @(_toastIsError ? "error" : "")" role="status" @key="_toastSeq">@_toast</div>
}

@code {
    private bool _searching;
    private bool _loadingArtistAlbums;
    private HashSet<string> _selectedAlbums = new();
    private HashSet<int> _selectedTracks = new();
    private int TotalSelected => _selectedAlbums.Count + _selectedTracks.Count;

    private string? _toast;
    private bool _toastIsError;
    private int _toastSeq;
    private int _toastGen;

    // La recherche de l'utilisateur connecté : conservée d'une page à l'autre, mais propre à chacun.
    private SearchStateService State => States.For(Guard.UserId);

    // Capturé une fois : OnQueueChanged arrive depuis les workers, hors du circuit.
    private string _me = "";

    // Page d'accueil ("/") : c'est elle qui porte le garde de session.
    protected override void OnInitialized()
    {
        base.OnInitialized();
        _me = Guard.UserId;
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

        // OnQueueChanged uniquement : sans cet abonnement, ni l'état « dans la file » ni la mention
        // « déjà téléchargé » ne se rafraîchiraient quand un élément se termine. S'abonner en plus
        // à OnProgressChanged redessinerait cette page à chaque bloc téléchargé, pour rien.
        Download.OnQueueChanged += OnQueueChanged;

        // La recherche précédente est restituée : son mur de pochettes aussi.
        UpdateAmbiance();
    }

    // Mur du fond : les pochettes de ce qui est affiché. Les miniatures suffisent, le mur étant
    // flouté et passé en gris.
    private void UpdateAmbiance()
    {
        IEnumerable<string?> covers =
            State.Albums?.Select(a => (string?)a.Image?.Thumbnail)
            ?? State.Tracks?.Select(t => (string?)t.Album?.Image?.Thumbnail)
            ?? (State.ArtistAlbums ?? new()).Select(a => (string?)a.Image?.Thumbnail)
                .Concat((State.Artists ?? new()).Select(a => a.Picture));
        Ambiance.SetCovers(this, covers);
    }

    private static readonly (string Type, string Key)[] SearchTypes =
    {
        ("albums", "search.albums"),
        ("tracks", "search.tracks"),
        ("artists", "search.artists"),
    };

    // ─── Modèles de rendu ───
    // Carte d'album : pochette nue, méta, puis la capsule C1 « choisir | télécharger ». Rien n'est
    // posé sur l'image.
    private RenderFragment AlbumTile(QobuzAlbum album, bool withArtist)
    {
        var id = album.Id;
        var url = AlbumUrl(id);
        var selected = _selectedAlbums.Contains(id);
        var queued = Download.IsQueued(_me, url);
        var done = Download.IsDone(_me, url);
        var title = album.Title + (album.Version != null ? $" ({album.Version})" : "");
        var img = album.Image;

        return @<article class="alb @(selected ? "is-sel" : "") @(queued ? "is-file" : "")">
            <div class="alb-cov">
                @if (img != null && !string.IsNullOrEmpty(img.Small))
                {
                    @* Dimensions fixées et carré réservé par le CSS (aspect-ratio) : la grille ne
                       saute pas pendant le chargement. *@
                    <img src="@img.Small" srcset="@AlbumSrcSet(img)" sizes="(max-width: 768px) 46vw, 220px"
                         width="230" height="230" alt="" loading="lazy" decoding="async" />
                }
            </div>
            <div class="alb-meta">
                <div class="alb-titre" title="@title">@title</div>
                @if (withArtist)
                {
                    <div class="alb-sous">@album.Artist?.Name</div>
                }
                <div class="alb-sous">@album.ReleaseDateOriginal &middot; @Loc.P("search.trackCount", album.TracksCount)</div>
                <div class="alb-format">
                    @(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz
                    @if (done)
                    {
                        <span class="r-etat">&middot; @Loc["queue.doneMark"]</span>
                    }
                </div>
            </div>
            @(Capsule(title, selected, queued, () => ToggleAlbum(id), () => QueueAlbum(album)))
        </article>;
    }

    // Capsule C1 : deux moitiés de 44 px. L'état (choisi, déjà dans la file) est porté par le
    // conteneur .alb. En ligne de liste (compact), la moitié Télécharger n'a que l'icône : son nom
    // accessible reprend alors l'action et le titre.
    private RenderFragment Capsule(string title, bool selected, bool queued, Action toggle, Action queue, bool compact = false)
    {
        var action = queued ? Loc["search.inQueue"] : Loc["search.download"];
        return @<div class="alb-caps">
            <button type="button" class="alb-caps-sel" aria-pressed="@(selected ? "true" : "false")"
                    aria-label='@Loc.T("search.selectItem", title)' @onclick="toggle">
                <i>
                    @if (selected)
                    {
                        <NavIcon Name="check" />
                    }
                </i>
            </button>
            <button type="button" class="alb-caps-dl" disabled="@queued" @onclick="queue"
                    aria-label='@Loc.T("search.itemAction", action, title)'>
                <NavIcon Name="download" />
                @if (!compact)
                {
                    <span>@action</span>
                }
            </button>
        </div>;
    }

    // Vignette de liste : miniature, et la taille au-dessus pour les écrans denses.
    private RenderFragment Cover(QobuzImage? image, int size) =>
        @<span class="vg" style="width:@(size)px;height:@(size)px">
            @if (image != null && !string.IsNullOrEmpty(image.Thumbnail))
            {
                <img src="@image.Thumbnail" srcset="@ThumbSrcSet(image)" sizes="@(size)px"
                     width="@size" height="@size" alt="" loading="lazy" decoding="async" />
            }
        </span>;

    private static string AlbumSrcSet(QobuzImage img) =>
        string.IsNullOrEmpty(img.Large) ? $"{img.Small} 230w" : $"{img.Small} 230w, {img.Large} 600w";

    private static string ThumbSrcSet(QobuzImage img) =>
        string.IsNullOrEmpty(img.Small) ? $"{img.Thumbnail} 50w" : $"{img.Thumbnail} 50w, {img.Small} 230w";

    // Seule sa propre file grise ou coche les boutons : ignorer celles des autres.
    private void OnQueueChanged(string? ownerId)
    {
        if (ownerId == null || ownerId == _me) InvokeAsync(StateHasChanged);
    }

    public override void Dispose()
    {
        base.Dispose();
        Download.OnQueueChanged -= OnQueueChanged;
        Ambiance.Clear(this);
    }

    private async Task DoSearch(string type)
    {
        if (string.IsNullOrWhiteSpace(State.Query)) return;
        _searching = true;
        State.LastSearchType = type;
        State.Albums = null;
        State.Tracks = null;
        State.Artists = null;
        State.ExpandedArtistId = 0;
        State.ArtistAlbums = null;

        try
        {
            switch (type)
            {
                case "albums":
                    var albumResult = await Api.SearchAlbumsAsync(State.Query, 50);
                    State.Albums = albumResult?.Albums?.Items ?? new();
                    break;
                case "tracks":
                    var trackResult = await Api.SearchTracksAsync(State.Query, 50);
                    State.Tracks = trackResult?.Tracks?.Items ?? new();
                    break;
                case "artists":
                    var artistResult = await Api.SearchArtistsAsync(State.Query, 50);
                    State.Artists = artistResult?.Artists?.Items ?? new();
                    break;
            }
        }
        catch
        {
            State.Albums = null;
            State.Tracks = null;
            State.Artists = null;
        }
        finally
        {
            _searching = false;
            UpdateAmbiance();
        }
    }

    private async Task ToggleArtist(int artistId)
    {
        if (State.ExpandedArtistId == artistId)
        {
            State.ExpandedArtistId = 0;
            State.ArtistAlbums = null;
            UpdateAmbiance();
            return;
        }

        State.ExpandedArtistId = artistId;
        State.ArtistAlbums = null;
        _loadingArtistAlbums = true;
        StateHasChanged();

        try
        {
            var artist = await Api.GetArtistFullAsync(artistId.ToString());
            State.ArtistAlbums = artist.Albums?.Items ?? new();
        }
        catch
        {
            State.ArtistAlbums = new();
        }
        finally
        {
            _loadingArtistAlbums = false;
            UpdateAmbiance();
        }
    }

    // ─── File d'attente ───
    // Méthodes synchrones : Enqueue rend la main et le worker draine en arrière-plan, on peut donc
    // continuer à chercher. La variable d'un foreach étant capturée par itération (C# 5),
    // `@onclick="() => QueueAlbum(album)"` désigne bien l'album de la ligne.

    private static string AlbumUrl(string id) => $"https://play.qobuz.com/album/{id}";
    private static string TrackUrl(int id) => $"https://play.qobuz.com/track/{id}";
    private static string ArtistUrl(int id) => $"https://play.qobuz.com/artist/{id}";

    private static QueueRequest AlbumRequest(QobuzAlbum a) => new(
        AlbumUrl(a.Id),
        a.Title + (a.Version != null ? $" ({a.Version})" : ""),
        a.Artist?.Name,
        a.Image?.Thumbnail);

    private static QueueRequest TrackRequest(QobuzTrack t) => new(
        TrackUrl(t.Id),
        t.Title + (t.Version != null ? $" ({t.Version})" : ""),
        t.Performer?.Name,
        t.Album?.Image?.Thumbnail);

    private void QueueAlbum(QobuzAlbum album) => ToastFor(Enqueue(AlbumRequest(album)));

    private void QueueTrack(QobuzTrack track) => ToastFor(Enqueue(TrackRequest(track)));

    private void QueueArtist(QobuzArtist artist) => ToastFor(Download.Enqueue(
        Guard.UserId, ArtistUrl(artist.Id), artist.Name, null, artist.Picture));

    private EnqueueResult Enqueue(QueueRequest r) =>
        Download.Enqueue(Guard.UserId, r.Url, r.Label, r.SubLabel, r.Thumbnail);

    private void ToastFor(EnqueueResult result)
    {
        var (msg, isError) = result switch
        {
            EnqueueResult.Added => (Loc.P("queue.added", 1), false),
            EnqueueResult.Requeued => (Loc["queue.requeued"], false),
            EnqueueResult.AlreadyQueued => (Loc["queue.alreadyQueued"], false),
            _ => (Loc["queue.invalidUrl"], true)
        };
        ShowToast(msg, isError);
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toast = message;
        _toastIsError = isError;
        _toastSeq++;

        // Compteur de génération : un toast plus récent neutralise le Task.Delay du précédent, qui
        // sinon effacerait le message affiché avant l'heure.
        var gen = ++_toastGen;
        _ = HideToastLater(gen);
    }

    private async Task HideToastLater(int gen)
    {
        await Task.Delay(1600);   // l'animation toastOut se termine à 1,5 s
        if (gen != _toastGen) return;
        _toast = null;
        // L'utilisateur a pu quitter la page entre-temps : le circuit est alors fermé et il n'y a
        // plus rien à redessiner.
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void ToggleAlbum(string id)
    {
        if (!_selectedAlbums.Remove(id)) _selectedAlbums.Add(id);
    }

    private void ToggleTrack(int id)
    {
        if (!_selectedTracks.Remove(id)) _selectedTracks.Add(id);
    }

    private void ToggleSelectAllAlbums()
    {
        if (State.Albums == null) return;
        if (_selectedAlbums.Count == State.Albums.Count)
            _selectedAlbums.Clear();
        else
            _selectedAlbums = new(State.Albums.Select(a => a.Id));
    }

    private void ToggleSelectAllTracks()
    {
        if (State.Tracks == null) return;
        if (_selectedTracks.Count == State.Tracks.Count)
            _selectedTracks.Clear();
        else
            _selectedTracks = new(State.Tracks.Select(t => t.Id));
    }

    private void ClearSelection()
    {
        _selectedAlbums.Clear();
        _selectedTracks.Clear();
    }

    private void DownloadSelected()
    {
        // Order the batch like the lists are displayed on screen rather than by the arbitrary
        // order of the selection HashSets. Anything selected in a previous search (no longer in
        // the visible lists) is still appended at the end, so nothing is silently dropped.
        var albumIds = new List<string>();
        var seenAlbums = new HashSet<string>();

        void AddAlbums(IEnumerable<string> ids)
        {
            foreach (var id in ids)
                if (_selectedAlbums.Contains(id) && seenAlbums.Add(id))
                    albumIds.Add(id);
        }

        if (State.Albums != null)
            AddAlbums(SearchSorter.SortAlbums(State.Albums, State.AlbumSort).Select(a => a.Id));
        if (State.ArtistAlbums != null)
            AddAlbums(SearchSorter.SortAlbums(State.ArtistAlbums, State.ArtistAlbumSort).Select(a => a.Id));
        AddAlbums(_selectedAlbums);

        var trackIds = new List<int>();
        if (State.Tracks != null)
            trackIds.AddRange(SearchSorter.SortTracks(State.Tracks, State.TrackSort)
                .Select(t => t.Id).Where(_selectedTracks.Contains));
        var seenTracks = trackIds.ToHashSet();
        trackIds.AddRange(_selectedTracks.Where(id => !seenTracks.Contains(id)));

        // Retrouver les objets pour alimenter libellé, artiste et vignette de la file. Un identifiant
        // sélectionné lors d'une recherche précédente n'est plus dans les listes visibles : on
        // l'enfile alors sur sa seule URL, plutôt que de le perdre en route.
        var albumById = new Dictionary<string, QobuzAlbum>();
        foreach (var a in (State.Albums ?? new()).Concat(State.ArtistAlbums ?? new()))
            albumById[a.Id] = a;

        var trackById = new Dictionary<int, QobuzTrack>();
        foreach (var t in State.Tracks ?? new())
            trackById[t.Id] = t;

        var requests = new List<QueueRequest>();
        foreach (var id in albumIds)
            requests.Add(albumById.TryGetValue(id, out var a)
                ? AlbumRequest(a)
                : new QueueRequest(AlbumUrl(id)));
        foreach (var id in trackIds)
            requests.Add(trackById.TryGetValue(id, out var t)
                ? TrackRequest(t)
                : new QueueRequest(TrackUrl(id)));

        ClearSelection();

        var (added, requeued, duplicates, invalid) = Download.EnqueueMany(Guard.UserId, requests);
        var queued = added + requeued;
        if (queued > 0) ShowToast(Loc.P("queue.added", queued));
        else if (duplicates > 0) ShowToast(Loc["queue.alreadyQueued"]);
        else if (invalid > 0) ShowToast(Loc["queue.invalidUrl"], isError: true);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch(State.LastSearchType);
    }
}
